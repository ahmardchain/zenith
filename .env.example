# Solana
RPC_URL=https://api.devnet.solana.com
# Admin / funder wallet (pays for setup). Defaults to ~/.config/solana/id.json
# ADMIN_KEYPAIR=/path/to/id.json

# LLM: any OpenAI-compatible endpoint (OpenRouter gives every model behind one key).
# Leave LLM_API_KEY empty to run in MOCK mode (deterministic heuristic judge, good for rehearsal).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Models (use any model IDs your endpoint supports). Jurors should be different
# model families so one model's blind spot can't decide a dispute.
SOLVER_MODEL=openai/gpt-4o-mini
WATCHER_MODEL=anthropic/claude-sonnet-4.5
JUROR1_MODEL=anthropic/claude-sonnet-4.5
JUROR2_MODEL=openai/gpt-4.1-mini
JUROR3_MODEL=meta-llama/llama-3.3-70b-instruct

# Solver behaviour for the demo: honest | evil (flips the honest answer) | naive (falls for prompt injection)
SOLVER_MODE=honest

# Oracle params used by `npm run setup`
BOND_SOL=0.05
WINDOW_SECS=60
JURY_TIMEOUT_SECS=600

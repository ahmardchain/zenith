{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["node/**/*.ts", "tests/**/*.ts"]
}

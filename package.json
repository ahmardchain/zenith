{
  "name": "zenith",
  "version": "0.1.0",
  "private": true,
  "description": "Zenith: an optimistic AI oracle on Solana. Bonded AI answers, open challenges, multi-model jury, slashing.",
  "type": "module",
  "scripts": {
    "idl": "node scripts/build-idl.mjs",
    "sync-ids": "node scripts/sync-ids.mjs",
    "setup": "tsx node/setup.ts",
    "nodes": "tsx node/run.ts",
    "demo": "tsx node/demo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "tsx --test node/llm.test.ts",
    "faucet": "tsx node/faucet.ts",
    "test:anchor": "anchor test --provider.cluster localnet",
    "build:web": "npm --prefix app ci && npm --prefix app run build",
    "deploy:web": "npm run build:web && npx wrangler@4 pages deploy app/dist --project-name zenith-oracle --branch main"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
